<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Android adaptive icons render the foreground larger than the final mask.
      Keep the complete pin inside the central safe zone so no part is cropped
      by circle, squircle or rounded-square launcher masks.
    -->
    <item
        android:left="21dp"
        android:top="21dp"
        android:right="21dp"
        android:bottom="21dp">
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/brand_mark" />
    </item>
</layer-list>
